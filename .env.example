# QQBot Docker Compose 环境变量。复制为根目录 .env 后填写，切勿提交真实值。
QQBOT_MYSQL_ROOT_PASSWORD=replace_with_a_long_random_password
QQBOT_MYSQL_PASSWORD=replace_with_a_different_long_random_password
QQBOT_MYSQL_HOST_PORT=3307

# 分别生成两个随机 32 字节密钥并进行 Base64 编码，二者不得相同。
QQBOT_REALTIME_SPOOL_KEY=replace_with_base64_32_byte_key
QQBOT_RECALL_WAL_KEY=replace_with_another_base64_32_byte_key

# NapCat 运行在宿主机，默认 HTTP 3001、WebSocket 6701。
NAPCAT_SELF_QQ_ID=replace_with_qq_number
NAPCAT_HOST_HTTP_PORT=3001
NAPCAT_HOST_WS_PORT=6701

# 历史回补默认关闭。启用时必须设置北京时间最早日期，早于当天零点的消息不会入库。
QQBOT_BACKFILL_ENABLED=false
QQBOT_BACKFILL_EARLIEST_DATE=2026-03-01

# 默认关闭 LLM；启用时使用 DeepSeek 官方 Provider。
QQBOT_LLM_ENABLED=false
QQBOT_LLM_PROVIDER=deepseek
QQBOT_LLM_MODEL=deepseek-v4-flash
QQBOT_DEEPSEEK_API_KEY=

# QQ 开放平台默认关闭；启用后只允许绑定 Owner 与秘书对话。
# OWNER_OPENID 必须填写 Owner 手机 QQ 发给机器人时 Gateway C2C 事件的 user_openid，
# 不是上面的数字 QQ 号。身份不匹配的 C2C 和所有群消息都只入库，不触发 Action 或回复。
QQBOT_OPEN_PLATFORM_ENABLED=false
QQBOT_OPEN_PLATFORM_APP_ID=
QQBOT_OPEN_PLATFORM_CLIENT_SECRET=
QQBOT_OPEN_PLATFORM_OWNER_OPENID=
QQBOT_OPEN_PLATFORM_LIFECYCLE_NOTIFICATIONS=true
QQBOT_OPEN_PLATFORM_PROACTIVE_NOTIFICATIONS=false
QQBOT_FOLLOW_UP_ENABLED=false
QQBOT_AGENDA_ENABLED=false
QQBOT_NOTIFICATION_POLICY_ENABLED=false

# 管理页面只映射到宿主机 127.0.0.1。密码至少 12 字节，不能与数据库密码复用。
QQBOT_ADMIN_ENABLED=true
QQBOT_ADMIN_HOST_PORT=8080
QQBOT_ADMIN_PASSWORD=replace_with_a_unique_admin_password

QQBOT_RUST_LOG=qqbot_server=info,qqbot=info,personal_secretary=info
