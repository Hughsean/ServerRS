# ServerRS Environment Variables
# Copy this to .env and fill in your actual values.
# These override values from config.toml. The real .env is gitignored.

DATABASE_URL=mysql://user:password@{ip}:{port}/server_rs
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
WEATHER_API_KEY=
QDRANT_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# ── Web Ingestion ──
# Distill LLM (DeepSeek / OpenAI-compatible chat). DEEPSEEK_API_KEY is a
# fallback for the distill key ONLY — it is never used for embeddings.
WEB_INGESTION_DISTILL_LLM_API_KEY=
WEB_INGESTION_FETCH_USER_AGENT=ServerRSKnowledgeBot/0.1 (mailto:you@example.com)
WEB_INGESTION_FETCH_PROXY_URL=
WEB_INGESTION_MIN_REQUEST_INTERVAL_MS=2000
WEB_INGESTION_REQUEST_JITTER_MS=1000
WEB_INGESTION_MAX_URLS_PER_SOURCE_PER_JOB=20
WEB_INGESTION_URL_ENQUEUE_DEDUPE_SECS=86400
# DEEPSEEK_API_KEY=

# ── Fresh Context ──
# Short-lived news/trend/gossip distill LLM. Local Ollama can leave api_key empty.
FRESH_CONTEXT_DISTILL_LLM_PROVIDER=Ollama
FRESH_CONTEXT_DISTILL_LLM_BASE_URL=http://127.0.0.1:18080/v1
FRESH_CONTEXT_DISTILL_LLM_CHAT_MODEL=qwen3:14b
FRESH_CONTEXT_DISTILL_LLM_API_KEY=
FRESH_CONTEXT_DISTILL_LLM_TEMPERATURE=0.1
FRESH_CONTEXT_DISTILL_LLM_TOP_P=0.9
FRESH_CONTEXT_DISTILL_LLM_TIMEOUT_SECS=180
