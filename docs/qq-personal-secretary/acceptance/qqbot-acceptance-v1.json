{
  "schema_version": 1,
  "suite_id": "qqbot-continuity-recall-artifact-health-v1",
  "description": "个人 QQ 智能秘书独立验收矩阵。状态只能由验收脚本依据测试发现与执行结果生成。",
  "gate": {
    "blocking_severities": ["P0", "P1"],
    "accepted_statuses": ["PASS"],
    "missing_test_is_failure": true,
    "blocked_test_is_failure": true
  },
  "evidence_levels": {
    "L1": "纯领域或纯函数单元测试",
    "L2": "使用 Fake 端口的应用用例测试",
    "L3": "隔离 MySQL 或本地协议 Mock 集成测试",
    "L4": "从生产入口到持久化/读取出口的垂直闭环",
    "L5": "故障注入、重启、幂等和恢复证据",
    "L6": "真实 NapCat 只读或真实事件验收"
  },
  "baseline_checks": [
    {
      "id": "BASE-FMT",
      "program": "cargo",
      "arguments": ["fmt", "--all", "--", "--check"]
    },
    {
      "id": "BASE-CLIPPY",
      "program": "cargo",
      "arguments": ["clippy", "-p", "personal-secretary", "-p", "qqbot", "-p", "qqbot-server", "--all-targets", "--", "-D", "warnings"]
    },
    {
      "id": "BASE-BOUNDARIES",
      "program": "cargo",
      "arguments": ["test", "-p", "digital-human-server", "--test", "workspace_boundaries"]
    },
    {
      "id": "BASE-DIFF-CHECK",
      "program": "git",
      "arguments": ["diff", "--check"]
    }
  ],
